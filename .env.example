# ============================================================
# Variables de Entorno - Portfolio (SQLite Version)
# No requiere instalar PostgreSQL ni Docker
# ============================================================

NODE_ENV=development
PORT=4000

# URL para SQLite (Base de datos local en archivo)
DATABASE_URL="file:./dev.db"

# JWT
JWT_SECRET=dev-jwt-secret-change-this-in-production-must-be-32-chars-minimum
JWT_REFRESH_SECRET=dev-refresh-secret-change-this-in-production-must-be-32-chars
JWT_EXPIRATION=15m
JWT_REFRESH_EXPIRATION=7d

# Frontend
CORS_ORIGIN=http://localhost:5173
VITE_API_URL=http://localhost:4000/api

# Configuración de Servidor de Correo SMTP para Forwarding de Mensajes de Contacto
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=albagarcialopez39@gmail.com
SMTP_PASS=tu-contraseña-de-aplicación-de-gmail
SMTP_FROM=albagarcialopez39@gmail.com

