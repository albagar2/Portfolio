# ============================================================
# Variables de Entorno - Portfolio (SQLite Version)
# ============================================================

NODE_ENV=development
PORT=4000

# URL para PostgreSQL (Docker)
DATABASE_URL="postgresql://portfolio_user:portfolio_secret_2024@localhost:5432/portfolio?schema=public"

# URL para SQLite (Descomentar para desarrollo local sin Docker)
# DATABASE_URL="file:./dev.db"

# JWT
JWT_SECRET=portfolio-secure-key-2024-secret-32-chars-long
JWT_REFRESH_SECRET=portfolio-refresh-secure-key-2024-secret-32
JWT_EXPIRATION=15m
JWT_REFRESH_EXPIRATION=7d

# Frontend
CORS_ORIGIN=http://localhost:3000
VITE_API_URL=http://localhost:4000/api
